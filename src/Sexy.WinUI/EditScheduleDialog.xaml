<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sexy.EditScheduleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MaxWidth="460">

        <StackPanel Spacing="4">
            <TextBlock Text="Active hours (local time, 24-hour clock)"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OnStartBox" Grid.Column="0" Header="From (OnStart)" PlaceholderText="07:00" />
                <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <TextBox x:Name="OnEndBox" Grid.Column="2" Header="Until (OnEnd)" PlaceholderText="24:00" />
            </Grid>
            <TextBlock Text="24:00 means midnight at the end of the day."
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Days" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="DayMonday" Grid.Row="0" Grid.Column="0" Content="Mon" />
                <CheckBox x:Name="DayTuesday" Grid.Row="0" Grid.Column="1" Content="Tue" />
                <CheckBox x:Name="DayWednesday" Grid.Row="0" Grid.Column="2" Content="Wed" />
                <CheckBox x:Name="DayThursday" Grid.Row="0" Grid.Column="3" Content="Thu" />
                <CheckBox x:Name="DayFriday" Grid.Row="1" Grid.Column="0" Content="Fri" />
                <CheckBox x:Name="DaySaturday" Grid.Row="1" Grid.Column="1" Content="Sat" />
                <CheckBox x:Name="DaySunday" Grid.Row="1" Grid.Column="2" Content="Sun" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Proxy server" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="ProxyServerBox" Header="ProxyServer ('auto' reads v2rayN)" PlaceholderText="auto" />
            <TextBox x:Name="BypassBox" Header="Bypass ('auto' for a standard private-range list)" PlaceholderText="auto" />
            <TextBox x:Name="ConfigPathBox" Header="V2rayNConfigPath (empty = default install path)" PlaceholderText="empty = default" />
        </StackPanel>

        <ToggleSwitch x:Name="RequirePortSwitch"
                      Header="Safety"
                      OnContent="Only turn the proxy ON when v2rayN is listening"
                      OffContent="Allow ON even if v2rayN is not listening"
                      IsOn="True" />

        <TextBlock x:Name="ErrorText"
                   Foreground="#C42B1C"
                   TextWrapping="WrapWholeWords"
                   Visibility="Collapsed"
                   FontSize="12" />
    </StackPanel>
</UserControl>
