<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sexy.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12">
        <StackPanel Spacing="10">

            <!-- Proxy row -->
            <Grid ColumnSpacing="12" Padding="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Proxy"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ProxyHint"
                               Text="-"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBlock x:Name="ProxyWord"
                           Grid.Column="1"
                           Text="OFF"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#A0A0A0"
                           VerticalAlignment="Center" />
                <ToggleSwitch x:Name="ProxySwitch"
                              Grid.Column="2"
                              OnContent=""
                              OffContent=""
                              VerticalAlignment="Center"
                              Toggled="ProxySwitch_Toggled"
                              AutomationProperties.Name="Toggle proxy" />
            </Grid>

            <!-- Schedule row -->
            <Grid ColumnSpacing="12" Padding="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Schedule"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SchedHint"
                               Text="-"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBlock x:Name="SchedWord"
                           Grid.Column="1"
                           Text="PAUSED"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FFC94D"
                           VerticalAlignment="Center" />
                <ToggleSwitch x:Name="SchedSwitch"
                              Grid.Column="2"
                              OnContent=""
                              OffContent=""
                              VerticalAlignment="Center"
                              Toggled="SchedSwitch_Toggled"
                              AutomationProperties.Name="Toggle schedule" />
            </Grid>

            <!-- Why a toggle is blocked, when it is -->
            <TextBlock x:Name="HintText"
                       Foreground="#FF99A4"
                       Visibility="Collapsed"
                       TextWrapping="WrapWholeWords"
                       FontSize="11" />

            <!-- Footer: actions + start with Windows -->
            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="6,7"/>
                <Button x:Name="EditButton" Grid.Column="1" Content="Edit Schedule..." Click="EditButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="6,7"/>
                <Button x:Name="LogButton" Grid.Row="1" Content="Open Log..." Click="LogButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="6,7"/>
                <Button x:Name="ExitButton" Grid.Row="1" Grid.Column="1" Content="Exit" Click="ExitButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="6,7"/>
            </Grid>

            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Start with Windows (to tray)"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="StartupSwitch"
                              Grid.Column="1"
                              OnContent=""
                              OffContent=""
                              VerticalAlignment="Center"
                              Toggled="StartupSwitch_Toggled"
                              AutomationProperties.Name="Start with Windows" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
