<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sexy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sexy Proxy">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (transparent so Mica shows through) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="16,0,0,0">
            <TextBlock Text="Sexy Proxy"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="14,8,14,14" VerticalAlignment="Top">

                <!-- Split: tiles left, minimal status card right -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: tappable tiles + startup toggle -->
                    <Grid Grid.Column="0" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="ProxyTile"
                                Grid.Row="0"
                                CornerRadius="10"
                                Padding="10,10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="ProxyTile_Click"
                                AutomationProperties.Name="Toggle proxy">
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <FontIcon x:Name="ProxyIcon"
                                          Glyph="&#xEA18;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="26"
                                          Foreground="#A0A0A0" />
                                <TextBlock Text="PROXY"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="140"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ProxyWord"
                                           Text="OFF"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#A0A0A0"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ProxySub"
                                           Text="tap to turn ON"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ScheduleTile"
                                Grid.Row="1"
                                CornerRadius="10"
                                Padding="10,10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="ScheduleTile_Click"
                                AutomationProperties.Name="Toggle schedule">
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <FontIcon x:Name="SchedIcon"
                                          Glyph="&#xE917;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="26"
                                          Foreground="#FFC94D" />
                                <TextBlock Text="SCHEDULE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="140"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="SchedWord"
                                           Text="PAUSED"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#FFC94D"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="SchedSub"
                                           Text="tap to resume"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="2"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="10"
                                Padding="14,11">
                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="StartupSwitch"
                                              Grid.Column="1"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center"
                                              Toggled="StartupSwitch_Toggled"
                                              AutomationProperties.Name="Start with Windows" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right column: three lines + pinned buttons -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Server -->
                            <Grid Grid.Row="0" Padding="2,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="17"
                                          Foreground="#9A9A9A"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ValueServer" Text="-" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="server" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- v2rayN port -->
                            <Grid Grid.Row="1" Padding="2,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="17"
                                          Foreground="#6CCB5F"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ValuePort" Text="-" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ValuePortSub" Text="-" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- Next change -->
                            <Grid Grid.Row="2" Padding="2,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE917;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="17"
                                          Foreground="#9A9A9A"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ValueNext" Text="-" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ValueNextSub" Text="-" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pinned to the bottom -->
                            <Grid Grid.Row="4" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="6,8"/>
                                <Button x:Name="EditButton" Grid.Column="1" Content="Edit..." Click="EditButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="6,8"/>
                                <Button x:Name="LogButton" Grid.Row="1" Content="Log..." Click="LogButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="6,8"/>
                                <Button x:Name="HideToTrayButton" Grid.Row="1" Grid.Column="1" Content="Hide" Click="HideToTrayButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="6,8"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Why the proxy tile is blocked, when it is -->
                <TextBlock x:Name="HintText"
                           Foreground="#FF99A4"
                           Visibility="Collapsed"
                           TextWrapping="WrapWholeWords"
                           FontSize="11" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
