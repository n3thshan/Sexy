<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sexy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sexy Proxy">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (transparent so Mica shows through) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="16,0,0,0">
            <TextBlock Text="Sexy Proxy"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Content: vertical Settings list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="2" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Padding="20,8,20,6"
                           FontSize="27"
                           FontWeight="SemiBold">Sexy Proxy</TextBlock>

                <!-- PROXY section -->
                <TextBlock Grid.Row="1" Padding="22,2,22,4"
                           FontSize="12"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">PROXY</TextBlock>

                <!-- Proxy switch row -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="12,0,12,6">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA18;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Proxy"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProxySub"
                                       Text="v2rayN listening on 127.0.0.1:10808"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBlock x:Name="ProxyOnOff"
                                       Text="Off"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Width="24"
                                       TextAlignment="Right" />
                            <ToggleSwitch x:Name="ProxySwitch"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ProxySwitch_Toggled"
                                          AutomationProperties.Name="Toggle proxy" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Refresh status row -->
                <Button Grid.Row="3" x:Name="RefreshButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="12,0,12,14"
                        Click="RefreshButton_Click"
                        AutomationProperties.Name="Refresh status">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72C;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Refresh status"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="RefreshSub"
                                       Text="Last check -"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <!-- SCHEDULE section -->
                <TextBlock Grid.Row="4" Padding="22,2,22,4"
                           FontSize="12"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">SCHEDULE</TextBlock>

                <!-- Schedule switch row -->
                <Border Grid.Row="5" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="12,0,12,6">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE917;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Schedule"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SchedSub"
                                       Text="-"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBlock x:Name="SchedOnOff"
                                       Text="Off"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Width="24"
                                       TextAlignment="Right" />
                            <ToggleSwitch x:Name="SchedSwitch"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="SchedSwitch_Toggled"
                                          AutomationProperties.Name="Toggle schedule" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Change schedule row -->
                <Button Grid.Row="6" x:Name="EditButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="12,0,12,14"
                        Click="EditButton_Click"
                        AutomationProperties.Name="Edit schedule">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE787;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Change schedule"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ScheduleSub"
                                       Text="-"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <!-- APP section -->
                <TextBlock Grid.Row="7" Padding="22,2,22,4"
                           FontSize="12"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">APP</TextBlock>

                <!-- Start with Windows row -->
                <Border Grid.Row="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="12,0,12,6">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF0E2;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Launch hidden to the tray"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBlock x:Name="StartupOnOff"
                                       Text="Off"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Width="24"
                                       TextAlignment="Right" />
                            <ToggleSwitch x:Name="StartupSwitch"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="StartupSwitch_Toggled"
                                          AutomationProperties.Name="Start with Windows" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Open log row -->
                <Button Grid.Row="9" x:Name="LogButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="12,0,12,6"
                        Click="LogButton_Click"
                        AutomationProperties.Name="Open log">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Open log"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="proxy-schedule.log"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <!-- Blocked / error line (theme default text) -->
                <TextBlock Grid.Row="10" x:Name="HintText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"
                           TextWrapping="WrapWholeWords"
                           FontSize="12"
                           Padding="22,4,22,0" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
