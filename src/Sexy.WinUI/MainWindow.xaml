<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sexy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sexy Proxy">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (transparent so Mica shows through) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="16,0,0,0">
            <TextBlock Text="Sexy Proxy"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Content: vertical Settings-style list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6" Margin="12,4,12,12" VerticalAlignment="Top">

                <!-- Proxy row -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="14,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Proxy"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProxySub"
                                       Text="-"
                                       FontSize="11"
                                       Foreground="#FF99A4"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <TextBlock x:Name="ProxyWord"
                                   Grid.Column="1"
                                   Text="OFF"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#A0A0A0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <ToggleSwitch x:Name="ProxySwitch"
                                      Grid.Column="2"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"
                                      Toggled="ProxySwitch_Toggled"
                                      AutomationProperties.Name="Toggle proxy" />
                    </Grid>
                </Border>

                <!-- Schedule row -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="14,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Schedule"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SchedSub"
                                       Text="-"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <TextBlock x:Name="SchedWord"
                                   Grid.Column="1"
                                   Text="PAUSED"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFC94D"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <ToggleSwitch x:Name="SchedSwitch"
                                      Grid.Column="2"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"
                                      Toggled="SchedSwitch_Toggled"
                                      AutomationProperties.Name="Toggle schedule" />
                    </Grid>
                </Border>

                <!-- Start with Windows row -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="14,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Launch hidden to the tray"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch"
                                      Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"
                                      Toggled="StartupSwitch_Toggled"
                                      AutomationProperties.Name="Start with Windows" />
                    </Grid>
                </Border>

                <!-- Edit schedule (clickable row) -->
                <Button x:Name="EditButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        CornerRadius="10"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderThickness="0"
                        Click="EditButton_Click"
                        AutomationProperties.Name="Edit schedule">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Edit Schedule"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ScheduleSub"
                                       Text="-"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <!-- Open log (clickable row) -->
                <Button x:Name="LogButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        CornerRadius="10"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderThickness="0"
                        Click="LogButton_Click"
                        AutomationProperties.Name="Open log">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Open Log"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="proxy-schedule.log"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>

                <!-- Why something is blocked, when it is -->
                <TextBlock x:Name="HintText"
                           Foreground="#FF99A4"
                           Visibility="Collapsed"
                           TextWrapping="WrapWholeWords"
                           FontSize="11" />

                <Grid ColumnSpacing="8" Margin="2,2,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="14" Padding="6,9"/>
                    <Button x:Name="HideToTrayButton" Grid.Column="1" Content="Hide to tray" Click="HideToTrayButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="14" Padding="6,9"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
