<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sexy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sexy">

    <!-- Invisible host. H.NotifyIcon needs a visual tree and a Loaded event
         to create the native tray icon, so the app keeps an empty window
         that never activates a visible UI. The whole interface lives in
         the tray panel (left-click the shield). -->
    <Grid x:Name="RootGrid" Background="Transparent" />
</Window>
