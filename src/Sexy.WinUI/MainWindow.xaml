<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sexy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sexy">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (transparent so Mica shows through) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Sexy"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="WinUI 3"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" MaxWidth="520" Margin="20,4,20,18">

                <!-- Hero: current state at a glance -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StateDot"
                             Width="14" Height="14"
                             Fill="#868686"
                             VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="StateHeadline"
                                   Text="Loading..."
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Reads the scheduler. Refreshes on focus or when you ask."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Status card -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <StackPanel x:Name="StatusRowsPanel" Spacing="6">

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Proxy" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValueProxy" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Server" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValueServer" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="v2rayN port" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValuePort" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Schedule" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValueSchedule" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Right now" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValueNow" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Paused" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValuePaused" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Next change" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValueNext" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Last check" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValueLastRun" Grid.Column="1" Text="-" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="OnButton" Content="Turn Proxy ON" Click="OnButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="False"/>
                    <Button x:Name="OffButton" Grid.Column="1" Content="Turn Proxy OFF" Click="OffButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ResumeButton" Grid.Column="2" Content="Resume Schedule" Click="ResumeButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <Button x:Name="PauseButton" Grid.Row="1" Content="Pause Schedule" Click="PauseButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="EditButton" Grid.Row="1" Grid.Column="1" Content="Edit Schedule..." Click="EditButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="LogButton" Grid.Row="1" Grid.Column="2" Content="Open Log..." Click="LogButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <Button x:Name="RefreshButton" Grid.Row="2" Grid.ColumnSpan="2" Content="Refresh Status" Click="RefreshButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CloseButton" Grid.Row="2" Grid.Column="2" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>

                <!-- Why ON is unavailable -->
                <TextBlock x:Name="HintText"
                           Foreground="#C42B1C"
                           Visibility="Collapsed"
                           TextWrapping="WrapWholeWords"
                           FontSize="12" />

                <!-- Result banner -->
                <InfoBar x:Name="ResultBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational" />

                <!-- Footer note -->
                <TextBlock Text="The task runs at 00:00, 07:00, and every 5 minutes as a safety check. Manual ON/OFF pauses the schedule; use Resume Schedule to hand control back."
                           TextWrapping="WrapWholeWords"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Sexy"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="2.0 (WinUI 3)"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
